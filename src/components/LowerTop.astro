---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="p-lower-top">
  <div class="p-lower-top__titleWrap">
    <h2 class="p-lower-top__title c-lower-top-title">{title}</h2><!-- /.p-lower-top__title -->
  </div><!-- /.p-lower-top__titleWrap -->
</div><!-- /.p-lower-top -->
