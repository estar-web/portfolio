---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { getWorks, imageSrcset, imageUrl, isPrivateWork } from '../lib/microcms';
import { GITHUB_URL, X_URL } from '../lib/site';

// トップのスライダーには、非公開実績を除いた新しい順の 10 件を表示する
const TOP_WORKS_LIMIT = 10;
const works = (await getWorks()).filter((work) => !isPrivateWork(work)).slice(0, TOP_WORKS_LIMIT);

const skills = [
  { icon: 'icon-html.svg', alt: 'HTML', width: 44, height: 50, label: 'HTML', text: 'HTML Living Standardに準拠したコーディング' },
  { icon: 'icon-css.svg', alt: 'CSS', width: 44, height: 50, label: 'CSS(Sass)', text: '保守・運用性を意識したコーディング、BEM, FLOCSSを意識したファイル構成' },
  {
    icon: 'icon-js.svg',
    alt: 'JavaScript',
    width: 50,
    height: 50,
    label: 'JavaScript(jQuery)',
    text: 'ライブラリを用いたアニメーション実装<br>（スライダー、スムーススクロール、フェードイン、アコーディオン、モーダルウィンドウ等）',
  },
];
---

<BaseLayout title="Webサイト制作はお任せください" isFront>
  <main>
    <div id="js-mv" class="p-mv">
      <div class="p-mv__inner l-inner">
        <h1 class="p-mv__ttl js-in-view fade-in-right">Code:<br />HOSHI</h1>
        <div class="p-mv__image js-in-view fade-in-left fade-in-delay"></div>
      </div>
    </div>

    <section id="works" class="l-works p-works">
      <div class="p-works__inner l-inner">
        <h2 class="p-works__title c-section-title js-in-view fade-in-up">Works</h2>
        <div class="swiper p-works__swiper js-in-view fade-in-up">
          <div class="swiper-wrapper p-works__wrapper">
            {
              works.map((work, index) => (
                <a href={`/works/${work.id}/`} class="swiper-slide p-works__slide">
                  <div class="p-works__item">
                    <figure class="p-works__img">
                      {work.thumbnail ? (
                        <img
                          src={imageUrl(work.thumbnail, 1024)}
                          srcset={imageSrcset(work.thumbnail, [480, 768, 1024, 1536])}
                          sizes="(min-width: 992px) 440px, 50vw"
                          width={work.thumbnail.width}
                          height={work.thumbnail.height}
                          alt=""
                          loading={index === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      ) : (
                        <img src="/assets/images/picture-demo1.webp" width="200" height="160" alt="画像：ダミー" loading="lazy" decoding="async" />
                      )}
                    </figure>
                    <div class="p-works__text">
                      <div class="p-works__item-title">{work.customer}</div>
                      <ul class="p-works__item-category-wrapper">
                        {work.categories.map((category) => (
                          <li class="p-works__item-category">{category.name}</li>
                        ))}
                      </ul>
                      <p class="p-works__item-comment">{work.comment}</p>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
        <div class="p-works__button js-in-view fade-in-up">
          <a href="/works/" class="p-works__link c-detail-button">制作実績をもっと見る</a>
        </div>
      </div>
    </section>

    <section id="profile" class="l-profile p-profile">
      <div class="c-deco__top"></div>
      <div class="p-profile__inner l-inner">
        <h2 class="p-profile__title c-section-title js-in-view fade-in-up">Profile</h2>
        <div class="p-profile__wrapper js-in-view fade-in-up">
          <figure class="p-profile__icon">
            <img src="/assets/images/icon-profile.webp" alt="アイコン画像" width="1080" height="1080" loading="lazy" />
          </figure>
          <div class="p-profile__spacer u-hide--sp"></div>
          <div class="p-profile__name">ほし</div>

          <div class="p-profile__link-wrapper">
            <a class="p-profile__link" href={X_URL} target="_blank" rel="noopener noreferrer">
              <svg class="p-profile__web-icon" width="20" height="18" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15.7508 0H18.8175L12.1175 7.6255L20 18H13.8283L8.995 11.7071L3.46333 18H0.395L7.56167 9.84345L0 0.0008298H6.32833L10.6975 5.75273L15.7508 0ZM14.675 16.1729H16.3742L5.405 1.73171H3.58167L14.675 16.1729Z" fill="#337AB7"></path>
              </svg>
              <i class="p-profile__account">@fre_e_star</i>
              <span class="p-profile__link--hover">Follow!</span>
            </a>
            <a class="p-profile__link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
              <svg class="p-profile__web-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="20" height="20">
                <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
              </svg>
              <i class="p-profile__account">GitHub</i>
              <span class="p-profile__link--hover">Follow!</span>
            </a>
          </div>
          <div class="p-profile__text">
            埼玉県でホームページ制作のお仕事をしております。<br />
            会社員時代はプログラマーとして働いていました。<br />
            認知拡大のための広告運用のご提案も可能です。<br />
            <div class="p-profile__label mt-20">■お仕事内容</div>
            <ul class="p-profile__list">
              <li class="p-profile__list-item">Webサイト制作</li>
              <li class="p-profile__list-item">既存サイト修正、レスポンシブ対応、WordPress化</li>
              <li class="p-profile__list-item">サイトの保守/運用</li>
              <li class="p-profile__list-item">Google/Meta広告の設定、運用</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="c-deco__bottom"></div>
    </section>

    <section id="skills" class="l-skills p-skills">
      <div class="p-skills__inner l-inner">
        <h2 class="p-skills__title c-section-title js-in-view fade-in-up">Skills</h2>
        <div class="p-skills__wrapper js-in-view fade-in-up">
          {
            skills.map((skill) => (
              <div class="p-skills__item">
                <figure class="p-skills__icon">
                  <img src={`/assets/images/${skill.icon}`} alt={`スキルセットアイコン(${skill.alt})`} width={skill.width} height={skill.height} loading="lazy" />
                </figure>
                <div class="p-skills__label">{skill.label}</div>
                <div class="p-skills__text" set:html={skill.text} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <div class="c-deco__top"></div>
    <section id="contact" class="l-contact p-contact">
      <ContactSection />
    </section>
  </main>

  <script>
    import '../scripts/top-works-slider';
  </script>
</BaseLayout>
