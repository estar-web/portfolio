---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LowerTop from '../../components/LowerTop.astro';
import LowerContact from '../../components/LowerContact.astro';
import { getWorks, imageSrcset, imageUrl, isPrivateWork, type Work } from '../../lib/microcms';

// 非公開実績は /works/ の表にまとめるので、詳細ページは作らない
export const getStaticPaths = (async () => {
  const works = await getWorks();
  return works
    .filter((work) => !isPrivateWork(work))
    .map((work) => ({
      params: { workId: work.id },
      props: { work },
    }));
}) satisfies GetStaticPaths;

interface Props {
  work: Work;
}

const { work } = Astro.props;

// 改行を保ったままメタ情報用に 1 行へまとめる
const description = work.comment?.replace(/\s+/g, ' ').trim();
const ogImage = work.thumbnail ? imageUrl(work.thumbnail, 1200) : undefined;
---

<BaseLayout title={work.customer} description={description} ogType="article" ogImage={ogImage}>
  <LowerTop title="Works" />

  <article class="l-achieve-detail p-achieve-detail">
    <div class="l-inner p-achieve-detail__inner">
      <div class="p-achieve-icatch">
        {
          work.thumbnail ? (
            <figure class="p-achieve-icatch__img p-icatch--pc">
              <img
                src={imageUrl(work.thumbnail, 1600)}
                srcset={imageSrcset(work.thumbnail, [768, 1024, 1600, 2048])}
                sizes="(min-width: 1040px) 1000px, 100vw"
                width={work.thumbnail.width}
                height={work.thumbnail.height}
                alt=""
                decoding="async"
                fetchpriority="high"
              />
            </figure>
          ) : (
            <figure class="p-achieve-icatch__img -private">
              <img src="/assets/images/picture-dummy.webp" width="310" height="180" alt="" loading="lazy" decoding="async" />
            </figure>
          )
        }
      </div>

      <div class="p-achieve-description">
        <dl class="p-achieve-list">
          <div class="p-achieve-list__wrapper p-achieve-list__client">
            <dt class="p-achieve-list__title">クライアント様 / 案件概要</dt>
            <dd class="p-achieve-list__text">{work.customer}</dd>
          </div>
          <div class="p-achieve-list__wrapper p-achieve-list__url">
            <dt class="p-achieve-list__title">URL</dt>
            <dd class="p-achieve-list__text">
              <a href={work.url} class="p-achieve-list__link" target="_blank" rel="noopener">
                <span class="p-achieve-list__link--nonHover">{work.url}</span>
                <span class="p-achieve-list__link--hover">View Site</span>
              </a>
            </dd>
          </div>
          <div class="p-achieve-list__wrapper p-achieve-list__area">
            <dt class="p-achieve-list__title">担当領域</dt>
            <dd class="p-achieve-list__text">{work.area}</dd>
          </div>
          <div class="p-achieve-list__wrapper p-achieve-list__period">
            <dt class="p-achieve-list__title">制作期間</dt>
            <dd class="p-achieve-list__text">{work.period}</dd>
          </div>
          <div class="p-achieve-list__wrapper p-achieve-list__price">
            <dt class="p-achieve-list__title">目安価格（税抜）</dt>
            <dd class="p-achieve-list__text">{work.price != null ? `¥${work.price.toLocaleString('ja-JP')}` : ''}</dd>
          </div>
          <div class="p-achieve-list__wrapper p-achieve-list__comment">
            <dt class="p-achieve-list__title">コメント</dt>
            <dd class="p-achieve-list__text">
              {
                work.comment?.split('\n').map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))
              }
            </dd>
          </div>
        </dl>
      </div>
      <div class="p-achieve-detail__button">
        <a href="/works/" class="p-achieve-detail__link c-detail-button">一覧に戻る</a>
      </div>
    </div>
  </article>

  <LowerContact />
</BaseLayout>
