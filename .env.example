# ---- microCMS --------------------------------------------------------------
# 未設定のままでも、src/data/fixtures のローカルデータでビルドできます。
# サービスID（https://xxxx.microcms.io の xxxx の部分）
MICROCMS_SERVICE_DOMAIN=
# 読み取り用 API キー（GET 権限のみ）
MICROCMS_API_KEY=

# 移行スクリプト（npm run microcms:import）専用。サイトのビルドには不要です。
# コンテンツの PUT 権限と「メディアのアップロード」権限を付けたキー
MICROCMS_WRITE_API_KEY=

# ---- お問い合わせフォーム ---------------------------------------------------
# Formspree などのフォーム送信先 URL（例: https://formspree.io/f/xxxxxxxx）
PUBLIC_FORM_ENDPOINT=
